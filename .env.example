# ============================================================================
# Bansal Lawyers Melbourne — Environment Configuration Template
# Duplicate this file as .env.local for local dev, or set on your Linux server.
# ============================================================================

# 1. Site Public URL
NEXT_PUBLIC_SITE_URL=https://www.bansallawyers.com.au

# ----------------------------------------------------------------------------
# 2. Linux & MySQL Database Configuration
# ----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bansal_user
MYSQL_PASSWORD=your_secure_mysql_password_here
MYSQL_DATABASE=bansal_lawyers_db
# Set to true if connecting to cloud MySQL with TLS/SSL:
MYSQL_SSL=false

# Optional: Full connection URI (if preferred over individual fields):
# DATABASE_URL=mysql://bansal_user:your_secure_mysql_password_here@127.0.0.1:3306/bansal_lawyers_db

# ----------------------------------------------------------------------------
# 3. SMTP Mail Configuration (Nodemailer)
# Fill these with your mail provider (Google Workspace, Microsoft 365, cPanel, SendGrid, etc.)
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set to true for port 465 (SSL), false for port 587 (STARTTLS):
SMTP_SECURE=false
SMTP_USER=your_email@bansallawyers.com.au
# For Gmail / Google Workspace, use an App Password (16 characters)
SMTP_PASS=your_email_app_password_or_smtp_key

# The sender display name and email:
SMTP_FROM_EMAIL="Bansal Lawyers" <no-reply@bansallawyers.com.au>

# The law firm inbox where client enquiries will be delivered:
NOTIFICATION_RECEIVER_EMAIL=info@bansallawyers.com.au

# ----------------------------------------------------------------------------
# 4. Optional Legacy Webhook & Administration
# ----------------------------------------------------------------------------
CONTACT_FORM_WEBHOOK_URL=
CONTACT_FORM_WEBHOOK_TOKEN=

# ----------------------------------------------------------------------------
# 5. Online Booking (/book-an-appointment) — CRM sync, same values as the legacy site
# Leave CRM_LEAD_POST_URL empty to skip CRM calls.
# ----------------------------------------------------------------------------
CRM_LEAD_POST_URL=
CRM_BOOKING_POST_URL=
CRM_DISABLED_TIME_SLOTS_URL=
CRM_DISABLED_TIME_SLOTS_TIMEOUT=5
CRM_DISABLED_TIME_SLOTS_USE_TOKEN=false
CRM_API_TOKEN=
# Optional overrides (defaults shown):
# CRM_LEAD_COUNTRY_CODE=+61
# CRM_LEAD_SOURCE=Website form
# CRM_LEAD_LEAD_STATUS=new
# CRM_BOOKING_LOCATION=melbourne
# CRM_BOOKING_MEETING_TYPE=in_person
# CRM_BOOKING_CONSULTANT_ID=
# CRM_BOOKING_CRM_SERVICE_ID=

# Cloudflare Turnstile for booking and contact forms. Set both to enable; leave both empty to disable.
# In development Cloudflare's always-pass test keys are used unless TURNSTILE_USE_PRODUCTION_KEYS=true.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_USE_PRODUCTION_KEYS=false
